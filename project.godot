; Engine configuration file.
; Edit with care: this is intentionally small for the Stage 1 prototype.

config_version=5

[application]

config/name="Ashen Pity"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/icon.svg"

[autoload]

GameBalance="*res://scripts/autoload/GameBalance.gd"
InputRouter="*res://scripts/autoload/InputRouter.gd"
SceneFlow="*res://scripts/autoload/SceneFlow.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=2

